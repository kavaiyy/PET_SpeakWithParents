{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Cpp main",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",

				"-g",
				// "${file}",
				"${fileDirname}/*.cpp",
				"${fileDirname}/*.h",

				"-o",
				"${fileDirname}/${fileBasenameNoExtension}",

				// ----------------------------------------------------------------------------------
				// ----------------------------------- WX-WIDGETS -----------------------------------
				// "wx-config --cxxflags",
				"-I/usr/lib/x86_64-linux-gnu/wx/include/gtk3-unicode-3.0",
				"-I/usr/include/wx-3.0",
				"-D_FILE_OFFSET_BITS=64",
				"-DWXUSINGDLL",
				"-D__WXGTK__",
				"-pthread",
				// "wx-config --libs",
				"-L/usr/lib/x86_64-linux-gnu",
				"-lwx_gtk3u_xrc-3.0",
				"-lwx_gtk3u_html-3.0",
				"-lwx_gtk3u_qa-3.0",
				"-lwx_gtk3u_adv-3.0",
				"-lwx_gtk3u_core-3.0","-lwx_baseu_xml-3.0",
				"-lwx_baseu_net-3.0",
				"-lwx_baseu-3.0"
				// ----------------------------------------------------------------------------------
				// ----------------------------------------------------------------------------------

			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "компилятор: /usr/bin/g++"
		}
	]
}